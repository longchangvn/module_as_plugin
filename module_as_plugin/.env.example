# Local Postgres (see module_as_plugin/docker-compose.yml).
# :5432 is occupied on some dev machines (see PROGRESS.md) — set POSTGRES_PORT=5433 then.
POSTGRES_PORT=5432

# Password for the least-privilege migration role `module_migrator`
# (LOGIN + CREATEDB). Wired into the container as POSTGRES_MIGRATOR_PASSWORD
# and consumed by db/init/01-migrator.sh on first init.
POSTGRES_MIGRATOR_PASSWORD=module_migrator

# Runtime (app) connections — unprivileged DML role `module_platform`.
# ConnectionStrings__Catalog="Host=localhost;Port=5432;Username=module_platform;Password=module_platform;Database=module_platform"
# ConnectionStrings__Tenant="Host=localhost;Port=5432;Username=module_platform;Password=module_platform;Database=module_platform"

# Design-time / migration connection (module_migrator). Read by both
# IDesignTimeDbContextFactory implementations and `dotnet ef` commands.
# MIGRATION_CONNECTION_STRING="Host=localhost;Port=5432;Username=module_migrator;Password=module_migrator;Database=module_platform"

# Per-tenant stores (provisioning). Platform creates databases/schemas with
# the privileged connection; Auth builds per-tenant connections from the
# base credentials + catalog metadata (dbName/schema). Secrets stay here,
# never in the catalog or API traffic.
# TenantStores__Host=localhost
# TenantStores__Port=5432
# TenantStores__Username=module_platform
# TenantStores__Password=module_platform
# TenantStores__SharedDatabase=module_platform
# TenantStores__ProvisioningConnection="Host=localhost;Port=5432;Username=module_migrator;Password=module_migrator;Database=postgres"
# Unset TenantStores__Host entirely to run the legacy single shared store.
